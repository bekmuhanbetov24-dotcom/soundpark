# Local PostgreSQL; keep password and DATABASE_URL in sync (URL-encode special characters).
POSTGRES_DB=soundpark
POSTGRES_USER=soundpark
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://soundpark:replace-with-local-password@127.0.0.1:5432/soundpark
API_PORT=3000

# Hosted API (configure as secret values in the hosting environment).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
